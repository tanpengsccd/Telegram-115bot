# Telegram-115Bot配置文件, 请检查所有必填项目，如不填会影响机器人正常运行

############################################日志设置##################################
# log_level （必填）
# 日志级别
# debug|info|warning|error|critical
log_level: info
############################################Telegram设置##################################
# bot token （必填）
# 机器人唯一Token，如果没有@BotFather创建
bot_token: your_bot_token

# allowed_user （必填）
# 授权可以使用该bot的user_id，可以通过@getidsbot获取
# 数字类型不要引号
# 支持单个用户ID或多个用户ID列表
# 单个用户: allowed_user: 123456789
# 多个用户: allowed_user: [123456789, 987654321, 555666777]
allowed_user: your_user_id

# 机器人名称 例如：@your_bot_name 
# 非必填，转存视频需要
bote_name: "@your_bot_name"

# telegram 的api信息 
# 非必填，转存视频需要
tg_api_id: your_tg_api_id
tg_api_hash: your_tg_api_hash

############################################115开放平台##################################
# 115_app_id 
# 申请地址https://open.115.com/
# 如已填写115_app_id, access_token,refresh_token可留空！
115_app_id: your_115_app_id

# 如没有115_app_id，请填写access_token和refresh_token！
# 115_app_id和token不能同时为空！！！
access_token: your_access_token
refresh_token: your_refresh_token

#############################################115离线下载设置###################################
# 下载完成后自动删除文件夹中的广告文件
clean_policy:
  # 是否开启自动清理 on: 开启 off: 关闭
  # 当设置为off时，所有策略不会生效，默认为开启
  switch: "on"
  # 文件小于设置值则自动删除单位K,M,G
  less_than: 400M

# 消息合并间隔（毫秒）
# 当用户在短时间内发送多条包含链接的消息时，自动合并为一个批量下载任务
# 例如：粘贴142个链接，Telegram分成3-5条消息发送，等待3秒后统一处理
msgs_merge_interval: 3000

# 设置分类文件夹
# 分类文件夹设置只针对离线任务，离线下载完成后，会弹出需要移动到的分类文件夹，可以设置多个
category_folder:
  # 电影下的分类目录
  - name: movies
    display_name: 电影
    path_map:
      # 显示名称
      - name: 外语电影
      # 对应115上的完整路径
        path: /影视/电影/外语电影
      - name: 华语电影
        path: /影视/电影/华语电影
      - name: 动画电影
        path: /影视/电影/动画电影
  # AV
  - name: av
    display_name: AV
    path_map:
      - name: 码の谜
        path: /AV/有码
      - name: 祼の真
        path: /AV/无码

#############################################软链接设置####################################
# strm可以极大地减小请求115的次数避免风控，建议开启
# create_strm只针对通过“dl”命令下载的资源有效，不建议使用“dl”下载AV资源
# AV资源建议使用“av”命令下载，并搭配第三方削刮工具自动生成软链，体验更好
# 是否创建软链（非302）
create_strm: true
# CloudDrive2 挂载115的根目录
mount_root: /CloudNAS/115
# 软链接根目录，软链接目录可以看成是115挂载目录的镜像，也是Emby设置媒体库的目录，需要挂载到容器
strm_root: /media/115

#############################################EMBY设置####################################
# 有新资源入库时会同时Emby扫库，所有媒体库建议按“加入日期”到排序
# EmbyServer地址 格式 http(s)://ip(域名):端口
emby_server: http://your_emby_server:8096
# Emby APIkey  Emby-->API秘钥-->新建
api_key: your_api_key

##########################################Aria2#######################################
# 设置Aria2可选择将离线的影片推送到Aria2
# 默认关闭
aria2:
  # 是否启用
  enable: false
  # 指定设备名称, 例如“我的群晖”，“我的飞牛”
  device_name: 我的飞牛
  # Arai2地址 http(s)://your_aria2_host
  host: http://your_aria2_host
  # Aria2 RPC端口
  port: 6800
  # Aria2 密钥
  rpc_secret: your_aria2_rpc_secret
  # 下载目录 (Aari2容器中的下载位置)
  dowload_path: "/Downloads"


# 自动重试最长等待上限（小时）：未完成的磁力每次重新添加后等待时间翻倍（10分→20分→40分…），
# 等待时间翻倍达到该上限且仍未完成时标记失败。可选 24 / 48 / 96 / 192 / 384（16天），也可在控制面板第2页修改（面板设置优先）
retry_max_wait_hours: 24
# 自动重试机制开关（默认关闭 false；也可在控制面板第2页实时开关，面板设置优先）
auto_retry_enabled: false
# 底部控制面板防抖刷新间隔（秒，默认 3 秒；短时间连发多个文件时合并为只重发一次面板）
panel_refresh_debounce_sec: 3
# 多链接文件确认超时自动下载默认文件夹的时间（秒，默认 30 秒；设为 0 关闭自动倒计时）
file_confirm_auto_timeout_sec: 30

#############################################Web 控制台与 REST API 设置###################################
web:
  # 是否随 TG Bot 同进程启用 Web 控制台与 REST API（也可运行 python app/web_server.py 独立启动）
  enabled: true
  # 监听地址（默认 0.0.0.0；若仅允许 1Panel/Nginx 本地反代可改为 127.0.0.1）
  host: "0.0.0.0"
  # 监听端口（默认 8115，Swagger 文档位于 /docs）
  port: 8115
  # 初始登录账号密码（首次启动会哈希存入 SQLite，之后可在 Web 设置页修改密码）
  username: "admin"
  password: "your_web_password"
  # 外部 REST API 密钥（Header: X-API-Key 或 Authorization: Bearer <key>；留空则首次启动自动生成，可在 Web 设置页查看/重置）
  api_key: ""
  # 通过 Web / API 提交的下载任务完成后，是否同步发一条汇总消息到 Telegram（默认开启，也可在 Web 设置页或单次请求中覆盖）
  notify_tg_on_web_download: true
